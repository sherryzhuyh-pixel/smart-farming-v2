# AI智慧养殖系统V2.0 - 环境变量配置模板
# 复制为 .env 后修改实际值

# 应用配置
APP_NAME=AI智慧养殖系统V2.0
APP_VERSION=2.0.0
DEBUG=false

# 数据库配置（SQLite 模式 - 推荐免费部署）
# Render上使用: sqlite:///data/smart_farming.db
# 本地开发使用: sqlite:///./smart_farming.db
DATABASE_URL=sqlite:///./smart_farming.db

# MySQL 配置（可选，留空则使用SQLite）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_breeding_v2
DB_CHARSET=utf8mb4

# JWT认证配置
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS白名单配置（逗号分隔，生产环境禁止设置为*）
# GitHub Pages域名示例: https://your-username.github.io
CORS_ALLOWED_ORIGINS=https://your-username.github.io,http://localhost:5173

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
