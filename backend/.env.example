# AI智慧养殖系统V2.0 - 环境变量配置模板（飞书Base版本）
# 复制为 .env 后修改实际值

# ── 应用配置 ──
APP_NAME=AI智慧养殖系统V2.0
APP_VERSION=2.0.0
DEBUG=false

# ── 飞书开放平台配置（必填） ──
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_BASE_TOKEN=xxxxxxxxxxxxxxxx        # Base 应用 Token

# ── 缓存配置 ──
CACHE_DIR=./cache
CACHE_SIZE_LIMIT=52428800   # 50MB

# ── JWT认证配置 ──
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS白名单配置（逗号分隔，生产环境禁止设置为*） ──
CORS_ALLOWED_ORIGINS=https://your-username.github.io,http://localhost:5173

# ── 初始管理员（启动时如果 users 表为空则自动创建） ──
# 密码需使用 bcrypt 哈希，生成方式：
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
