# AI智慧养殖系统 V2.0 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 飞书开放平台配置 ──
# 在飞书开放平台 (https://open.feishu.cn/app) 创建应用后获取
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书多维表格 Token（打开 Base → 复制链接中的 token）
LARK_BASE_TOKEN=xxxxxxxxxxxxxxxx

# ── JWT 认证 ──
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS ──
# 前端 GitHub Pages 地址（部署后更新为实际地址）
CORS_ALLOWED_ORIGINS=https://sherryzhuyh-pixel.github.io/smart-farming-v2,https://sherryzhuyh-pixel.github.io

# ── 初始管理员 ──
ADMIN_USERNAME=admin
# 生成密码哈希：python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD_HASH=

# ── 缓存 ──
CACHE_DIR=./cache
CACHE_SIZE_LIMIT=52428800

# ── 调试 ──
DEBUG=false
