# AI智慧养殖系统 V2.0 - PythonAnywhere 生产环境配置
# 复制此文件为 .env 并填入实际值

# ── 飞书开放平台配置 ──
LARK_APP_ID=your_app_id_here
LARK_APP_SECRET=your_app_secret_here
LARK_BASE_TOKEN=your_base_token_here

# ── JWT 认证 ──
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://sherryzhuyh-pixel.github.io/smart-farming-v2,https://sherryzhuyh-pixel.github.io

# ── 初始管理员 ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_password_hash_here

# ── 缓存 ──
CACHE_DIR=./cache
CACHE_SIZE_LIMIT=52428800

# ── 调试 ──
DEBUG=false
